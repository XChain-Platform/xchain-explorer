# xchain-explorer configuration. Copy to .env and fill in values.
# REST + JSON-RPC API and web UI reading from the indexer DB. Database
# credentials are NOT set here; they are supplied via the fetched node config
# (see NODE_CONFIG / the hub config oracle).

# Optional: HTTP and HTTPS API ports.
EXPLORER_API_PORT_HTTP=8080
# EXPLORER_API_PORT_HTTPS=8081

# Optional: interface to bind (default 127.0.0.1).
# API_HOST=127.0.0.1

# Optional: API rate limit in requests per minute per IP (default 500).
# EXPLORER_RATE_LIMIT_RPM=500

# Optional: global cap on requests served concurrently, across ALL client IPs
# (default 200). The per-IP limit above is blind to a stampede spread over many
# addresses; over this cap the explorer answers 429 + Retry-After immediately
# rather than queueing. Static icon/image requests are exempt. 0 disables.
# EXPLORER_MAX_CONCURRENT_REQUESTS=200

# Optional: directory holding TLS cert/key for HTTPS (default <root>/ssl).
# SSL_DIR=

# Optional: path to a node config JSON file, and the on-disk config cache.
# NODE_CONFIG=
# CONFIG_CACHE_FILE=
# Optional: ms between hub config refreshes (default 60000).
# UPDATE_CONFIG_INTERVAL=60000

# --- Hub connection (optional) ------------------------------------------------
# Optional: comma-separated validator hub list; falls back to single host/port.
# HUB_VALIDATORS=
# HUB_API_HOST=localhost
# HUB_PORT=10000
# Optional: hub request retry tuning.
# HUB_RETRY_ATTEMPTS=4
# HUB_RETRY_DELAY_MS=2000

# --- WebSocket live updates (optional; defaults shown) ------------------------
# WS_ENABLED=true
# WS_POLL_INTERVAL=5000
# WS_PING_INTERVAL=30000
# WS_IDLE_TIMEOUT=300000
# WS_MAX_CONNECTIONS_PER_IP=5
# WS_MAX_BACKPRESSURE=65536
# WS_MAX_SUBSCRIPTIONS=25

# --- Font Awesome kit (optional) ----------------------------------------------
# The web UI loads its generic glyphs from a Font Awesome kit. The kit token is
# an account credential and the "pro" license flag is an entitlement claim, so
# both are set per deployment and never committed. Leave the token empty to run
# without the kit: the navbar coin glyphs are local images and still render.
# EXPLORER_FONTAWESOME_KIT_TOKEN=
# Optional: numeric kit id, kit version (default 6.4.0), and the entitlement
# this deployment actually holds ("free" or "pro"; default free).
# EXPLORER_FONTAWESOME_KIT_ID=
# EXPLORER_FONTAWESOME_KIT_VERSION=6.4.0
# EXPLORER_FONTAWESOME_KIT_LICENSE=free
# Optional: path of the kit's uploaded-icons stylesheet, if the kit has one.
# EXPLORER_FONTAWESOME_KIT_CUSTOM_ICONS_PATH=

# Optional: MariaDB per-query timeout in ms (default 30000).
# DB_QUERY_TIMEOUT=30000

# Optional: verbose debug logging (set to any truthy value).
# DEBUG=
