{
  "name": "xchain-explorer",
  "description": "xchain-explorer is a free open source token platform explorer and set of APIs to pull data from the XChain platform supported blockchains",
  "version": "1.15.4",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-platform/xchain-explorer.git"
  },
  "dependencies": {
    "acorn": "8.16.0",
    "acorn-walk": "8.3.5",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-json-rpc-router": "^1.4.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mariadb": "3.5.2",
    "mathjs": "15.2.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "xchain-vm": "file:./xchain-vm"
  },
  "scripts": {
    "api": "node ./src/api.js",
    "vendor:vm": "bash bin/vendor-vm.sh",
    "check:vm": "bash bin/vendor-vm.sh check",
    "test": "mocha 'test/unit/**/*.test.js' --timeout 0 --exit --recursive",
    "coverage": "c8 --reporter=text --reporter=html --include 'src/**/*.js' mocha 'test/unit/**/*.test.js' --timeout 0 --recursive --exit",
    "ci": "npm run check:vm && mocha 'test/unit/**/*.test.js' --timeout 10000 --recursive --exit && npm run ci:security && npm run test:boundary:unit",
    "ci:security": "mocha 'test/security/**/*.test.js' --timeout 5000 --exit --recursive",
    "test:ws": "mocha test/unit/ws/*.test.js --timeout 0 --exit",
    "test:utility": "mocha test/unit/utility.test.js --timeout 0",
    "test:db": "mocha test/unit/db.*.test.js --timeout 0 --exit",
    "test:explorer": "mocha test/unit/explorer.*.test.js --timeout 0 --exit",
    "test:config": "mocha test/unit/config.test.js test/unit/hub-connector.test.js --timeout 0 --exit",
    "test:integration": "bash bin/run-integration.sh",
    "test:conformance": "mocha test/conformance/**/*.test.js --timeout 120000 --exit --recursive",
    "test:e2e": "mocha test/e2e/**/*.test.js --timeout 30000 --exit --recursive",
    "test:integration:up": "docker compose -f test/integration/fixtures/docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f test/integration/fixtures/docker-compose.test.yml down -v",
    "test:smoke": "mocha test/smoke/**/*.test.js --timeout 15000 --exit --recursive",
    "test:smoke:unit": "mocha test/smoke/unit/**/*.test.js --timeout 5000 --exit --recursive",
    "test:smoke:connected": "mocha test/smoke/connected/**/*.test.js --timeout 15000 --exit --recursive",
    "test:boundary": "mocha test/boundary/**/*.test.js --timeout 30000 --exit --recursive",
    "test:boundary:unit": "mocha test/boundary/unit/**/*.test.js --timeout 5000 --exit --recursive",
    "test:fuzz": "mocha test/fuzz/**/*.fuzz.js --timeout 60000 --exit --recursive",
    "test:fuzz:deep": "FUZZ_ITERATIONS=10000 mocha test/fuzz/**/*.fuzz.js --timeout 120000 --exit --recursive",
    "test:boundary:integration": "mocha test/boundary/integration/**/*.test.js --timeout 30000 --exit --recursive",
    "test:security": "mocha test/security/**/*.test.js --timeout 5000 --exit --recursive",
    "test:performance": "node --expose-gc ./node_modules/.bin/mocha test/performance/**/*.test.js --timeout 0 --exit --recursive",
    "test:chaos": "node --expose-gc ./node_modules/.bin/mocha test/chaos/**/*.test.js --timeout 0 --exit --recursive",
    "test:chaos:db": "node --expose-gc ./node_modules/.bin/mocha test/chaos/db-resilience.test.js --timeout 0 --exit",
    "test:chaos:api": "node --expose-gc ./node_modules/.bin/mocha test/chaos/api-overload.test.js --timeout 0 --exit",
    "test:chaos:network": "node --expose-gc ./node_modules/.bin/mocha test/chaos/network-partition.test.js --timeout 0 --exit",
    "test:chaos:resource": "node --expose-gc ./node_modules/.bin/mocha test/chaos/resource-saturation.test.js --timeout 0 --exit",
    "test:chaos:external": "node --expose-gc ./node_modules/.bin/mocha test/chaos/external-deps.test.js --timeout 0 --exit",
    "test:chaos:up": "docker compose -f test/chaos/fixtures/docker-compose.chaos.yml up -d --wait",
    "test:chaos:down": "docker compose -f test/chaos/fixtures/docker-compose.chaos.yml down -v",
    "test:mutation": "npx stryker run test/mutation/stryker.config.mjs",
    "test:mutation:utility": "npx stryker run test/mutation/stryker.config.mjs --mutate 'src/utility.js'",
    "test:mutation:db": "npx stryker run test/mutation/stryker.config.mjs --mutate 'src/db.js'",
    "test:mutation:explorer": "npx stryker run test/mutation/stryker.config.mjs --mutate 'src/XChainExplorer.js'",
    "test:mutation:config": "npx stryker run test/mutation/stryker.config.mjs --mutate 'src/config.js'",
    "test:regression": "mocha test/regression/**/*.test.js --timeout 30000 --exit --recursive",
    "test:regression:p0": "mocha test/regression/p0-*.test.js --timeout 30000 --exit",
    "test:regression:p0:unit": "mocha test/regression/p0-core-unit.test.js test/regression/p0-security-baseline.test.js --timeout 0 --exit",
    "test:regression:p1": "mocha test/regression/p0-*.test.js test/regression/p1-*.test.js --timeout 30000 --exit",
    "test:regression:full": "mocha test/regression/**/*.test.js --timeout 30000 --exit --recursive"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/mocha-runner": "^9.6.1",
    "autocannon": "^7.15.0",
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "decimal.js": "10.4.3",
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "fast-uri": "^3.1.5",
    "hyperid": "^4.0.0",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.0",
    "form-data": "^4.0.6",
    "tmp": "^0.2.7"
  },
  "engines": {
    "comment": "Bounded to Node 22: the vendored xchain-vm optional dependency pulls isolated-vm 5.0.4, whose native binding fails node-gyp on Node 24 (removed V8 API). Being optional makes that a SILENT skip rather than a loud install failure, so the contract-read paths would go missing at runtime instead. See .nvmrc.",
    "node": ">=22.0.0 <23"
  }
}
