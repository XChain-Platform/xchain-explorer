                "/components/footer/init.js",
                "/components/theme-toggle/init.js",
                "/js/moment.min.js",
                "/js/livestamp.min.js",
                "/js/numeral.js"
            ]
        },
        "math": {
            "assets": ["/js/math.min.js"]
        },
