# Triage note (, review-store #2231): this file has never held a
# credential. It was created as a drive-by one-liner (`strict-ssl=false`) inside
# an otherwise unrelated commit, which silently turned OFF TLS certificate
# verification for every registry fetch in this repo, dependency installs
# included. The public registry answers fine over verified TLS, so the setting
# bought nothing and left the dependency chain open to interception.
#
# It is pinned ON rather than merely deleted: an explicit project-level value
# overrides whatever a user-level ~/.npmrc sets, so the guarantee holds no
# matter whose machine runs the install.
strict-ssl=true

# Registry auth tokens belong in the user-level ~/.npmrc or the CI secret store,
# never here. test/security/npmrc-hygiene.test.js fails the build if a
# credential key or a strict-ssl downgrade lands in this file.
