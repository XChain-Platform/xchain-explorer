{
    "blocking": [
        "/js/jquery.min.js",
        "/js/browser_logger.js",
        "/js/network_coin.js",
        "/js/formatters.js",
        "/js/components.js",
        "/js/xchain.js"
    ],
    "groups": {
        "core": {
            "assets": [
                "/css/bootstrap.min.css",
                "/themes/classic/tokens.css",
                "/fontawesome/css/all.min.css",
                "/fontawesome/css/v4-shims.min.css",
                "/css/xchain.css",
                "/components/data-table/component.css",
                "/components/nav/component.css",
                "/components/search-box/component.css",
                "/components/footer/component.css",
                "/components/theme-toggle/component.css",
                "/js/jquery.min.js",
                "/js/bootstrap.bundle.min.js",
                "/js/browser_logger.js",
                "/js/network_coin.js",
                "/js/formatters.js",
                "/js/components.js",
                "/js/xchain.js",
                "/js/xchain/params.js",
                "/js/xchain/address_utils.js",
                "/js/xchain/network_status.js",
                "/js/xchain/api_proof.js",
