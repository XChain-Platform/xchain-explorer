        "contract.html": ["datatable", "highlight"],
        "dispenser.html": ["datatable"],
        "execution.html": [],
        "fees.html": ["datatable"],
        "governance.html": [],
        "home.html": [],
        "market.html": ["market"],
        "mempool.html": [],
        "oracle.html": ["datatable"],
        "poll.html": ["datatable"],
        "polls.html": ["datatable"],
        "privacy.html": [],
        "rich_list.html": ["math"],
